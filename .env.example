# Trading EZ - Variables de Entorno
# Servidor y Entorno
ENV=production
PORT=8000
HOST=0.0.0.0
SECRET_KEY=trading-ez-secret-key-change-in-production

# Directorios de Almacenamiento (compatibles con volumen persistente en Render / Docker)
DATA_CACHE_DIR=data/cache
DATABASE_URL=sqlite:///data/db/trading_ez.db

# Proveedores de Datos (Opcionales para modo extendido / Paper Trading real)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

FINNHUB_API_KEY=

BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Capa de IA Generativa de Apoyo (Claude o Gemini)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
